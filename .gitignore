# ============ 数据产物（每次刷新重建，不纳入版本库）============
data/
web/
dist/
collect/*_daily.json
collect/neodata_*.json
collect/warehouse_*.json
collect/opinions_*.json
collect/inventory_*.json
collect/ima_push_*.json
# 运行生成的状态文件（不应入库，避免本地 / GitHub 互推冲突）
collect/refresh_status.json
# 抓取中间数据
collect/raw/
# 当日资金流快照每次刷新重建；但逐日历史缓存幂等可复用，纳入版本库
# （与 raw_hist/agg_*.json 同理，避免云端 CI 首次运行重抓 36 品种 × 22 交易日）
collect/raw_capflow/*
!collect/raw_capflow/hist_*.json
!collect/raw_capflow/scoreinput_*.json
# 全月份数据源：产物 + 月份日线 + 逐日三榜缓存，均为幂等可复用缓存，纳入版本库，
# 避免云端 CI 首次运行时重抓 41 品种 × 22 交易日 × 多个月份三榜。
!collect/raw_capflow/allmonths_*.json
!collect/raw_capflow/amdaily/
!collect/raw_capflow/amdaily/**
!collect/raw_capflow/amrank/
!collect/raw_capflow/amrank/**
collect/_websearch_partial_*.json
collect/_run_report_*.md
collect/_t20_dates.json
collect/_t20_variety.json
collect/_collect_*.log
collect/_*.log
_*.log
run_report.json

# 顶层调试/临时脚本与记录（仅根目录，不影响 collect/ 下合法脚本）
/_*.py
/_*.md
/cloud_*_result.md
/cloud_*_probe.md

# ============ 但保留：前20净持仓历史曲线 + 人工维护的观点补丁 ============
!collect/raw_hist/
!collect/_websearch_opinions.json
# 金十期货 / 东方财富期货资讯 机构观点补丁：人工/自动化采集落盘，纳入版本库
# 使每日 CI（qhkch 覆盖式直抓）重建后，这两路门户观点不丢失。
!collect/_jin10_opinions.json
!collect/_eastmoney_opinions.json
# 前20会员席位 + 标准仓单：由本地 NeoData 连接器解析生成，GitHub 云端无此连接器，
# 故作为「静态快照」纳入版本库，使 GitHub Pages 版也能展示前20与仓单（数据滞后于本地最近一次刷新）。
!collect/neodata_*.json
!collect/warehouse_*.json

# ============ Python ============
__pycache__/
*.pyc
.venv/
venv/
env/
*.egg-info/

# ============ 本地/平台特定 ============
.workbuddy/
.wbapp*
.DS_Store
node_modules/
*.tmp

# ============ 本地备份与一次性脚本（体积大 / 无运行时依赖，不入库）============
# 备份目录合计约 430MB，切勿推到 GitHub
/.bak_*/
/backup/
/_rb_snap.json
/.ci*.log
collect/_*.bak_*
collect/_build_*.py
collect/_enrich_*.py
collect/_gen_*.py
collect/build_agrib.py
collect/build_metal_json.py
# GitHub Actions 运行时生成的 Pages 产物目录（部署用，非源码）
/public/

# pages/index.html 是本地最新离线快照，CI 在「周末跳过 / 抓取失败无 dist」时用它兜底，
# 必须入库；不要把它加进 dist/ 或 web/ 的忽略规则。
